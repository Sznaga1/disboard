{
  "manifest_version": 3,
  "name": "Disboard",
  "version": "1.0.0",
  "description": "Twoja lista Disboard pod ręką: „Oglądam”, +1 odcinek jednym kliknięciem, nowe odcinki na ikonce.",
  "key": "",
  "icons": {
    "16": "icons/icon-192.png",
    "32": "icons/icon-192.png",
    "48": "icons/icon-192.png",
    "128": "icons/icon-192.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Disboard",
    "default_icon": {
      "16": "icons/icon-192.png",
      "32": "icons/icon-192.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "https://firestore.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://graphql.anilist.co/*",
    "https://api.jikan.moe/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Otwórz okienko Disboard"
    }
  }
}
